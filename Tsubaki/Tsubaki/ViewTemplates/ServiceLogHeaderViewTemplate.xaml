<?xml version="1.0" encoding="utf-8" ?>
<Grid
    x:Class="Tsubaki.ViewTemplates.ServiceLogHeaderViewTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Tsubaki.ViewModels"
    x:DataType="viewmodels:DeploysViewModel"
    RowDefinitions="Auto,Auto,Auto">
    <!--  Browser launcher  -->
    <Border
        Grid.Row="0"
        Margin="0,10,0,20"
        StrokeShape="RoundRectangle 16"
        StrokeThickness="0">
        <SwipeView>
            <SwipeView.LeftItems>
                <SwipeItems Mode="Execute">
                    <SwipeItemView Command="{x:Binding LaunchServiceCommand}">
                        <Grid
                            Padding="16,8"
                            BackgroundColor="LightGreen"
                            RowDefinitions="*,Auto"
                            RowSpacing="1">
                            <Image Grid.Row="0" Source="rocket_launch_28dp.png" />

                            <Label
                                Grid.Row="1"
                                FontFamily="PoppinsMedium"
                                Text="Launch website" />
                        </Grid>
                    </SwipeItemView>
                </SwipeItems>
            </SwipeView.LeftItems>

            <Grid BackgroundColor="{x:AppThemeBinding Dark={x:StaticResource Gray600}, Light={x:StaticResource Gray100}}" HeightRequest="60">
                <Label
                    Margin="0,0,16,0"
                    FontFamily="PoppinsSemiBold"
                    HorizontalOptions="End"
                    Text="Slide right"
                    VerticalOptions="Center" />
            </Grid>
        </SwipeView>
    </Border>

    <!--  Keep alive card  -->
    <Border
        Grid.Row="1"
        Margin="0,20"
        Style="{x:StaticResource SoftCard}">
        <Grid
            Padding="16"
            ColumnDefinitions="*,*"
            HorizontalOptions="Fill"
            MinimumHeightRequest="200"
            RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Label
                Grid.Row="0"
                Grid.ColumnSpan="2"
                FontFamily="PoppinsSemiBold"
                FontSize="32"
                Text="Keep Alive"
                TextColor="#4CAF50" />

            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                <Label Style="{x:StaticResource CardSubtitleLabel}" Text="Past retries" />
                <Label Style="{x:StaticResource CardTitleLabel}" Text="{x:Binding RetryCounterHistory, StringFormat='{0} times'}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                <Label Style="{x:StaticResource CardSubtitleLabel}" Text="Current retries" />
                <Label Style="{x:StaticResource CardTitleLabel}" Text="{x:Binding KeepAliveRetryCounter, StringFormat='{0} times'}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Margin="0,4,0,0">
                <Label Style="{x:StaticResource CardSubtitleLabel}" Text="Status" />

                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="20"
                    Style="{x:StaticResource CardTitleLabel}"
                    Text="{x:Binding KeepAliveStatusMessage}" />
            </VerticalStackLayout>

            <Grid
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="8"
                HorizontalOptions="Fill">
                <Button
                    Grid.Column="0"
                    Command="{x:Binding TriggerKeepAliveCommand}"
                    IsEnabled="{x:Binding KeepAliveNotActive}"
                    MinimumWidthRequest="48"
                    Text="Start" />

                <Button
                    Grid.Column="1"
                    BackgroundColor="{x:AppThemeBinding Light={x:StaticResource SecondaryBtnBg},
                                                        Dark={x:StaticResource Gray900}}"
                    Command="{x:Binding StopKeepAliveCommand}"
                    MinimumWidthRequest="48"
                    Text="Stop"
                    TextColor="#673AB7" />
            </Grid>
        </Grid>
    </Border>

    <!--  title  -->
    <Label
        Grid.Row="2"
        Margin="0,16,0,8"
        Style="{x:StaticResource PageSubtitleLabel}"
        Text="Render activity logs" />
</Grid>
